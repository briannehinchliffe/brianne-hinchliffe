{
  "name": "brianne-hinchliffe",
  "version": "1.0.0",
  "description": "A custom WordPress theme for briannehinchliffe.com",
  "author": "Brianne Hinchliffe",
  "license": "GPL-2.0-or-later",
  "keywords": [
    "WordPress",
    "Theme"
  ],
  "homepage": "https://briannehinchliffe.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/briannehinchliffe/brianne-hinchliffe.git"
  },
  "bugs": {
    "url": "https://github.com/briannehinchliffe/brianne-hinchliffe/issues"
  },
  "devDependencies": {
    "@wordpress/scripts": "^32.0.0",
    "dir-archiver": "^3.0.1",
    "sass": "^1.99.0",
    "rtlcss": "^4.3.0"
  },
  "rtlcssConfig": {
    "options": {
      "autoRename": false,
      "autoRenameStrict": false,
      "blacklist": {},
      "clean": true,
      "greedy": false,
      "processUrls": false,
      "stringMap": []
    },
    "plugins": [],
    "map": false
  },
  "scripts": {
    "watch": "sass sass:./ --style=expanded --source-map --watch",
    "compile:css": "sass sass:./ --style=expanded --no-source-map && stylelint '*.css' --fix",
    "compile:rtl": "rtlcss style.css style-rtl.css",
    "lint:scss": "wp-scripts lint-style 'sass/**/*.scss'",
    "lint:scss:fix": "wp-scripts lint-style 'sass/**/*.scss' --fix",
    "lint:js": "wp-scripts lint-js 'js/*.js'",
    "bundle": "dir-archiver --src . --dest ../_s.zip --exclude .DS_Store .stylelintrc.json .eslintrc .git .gitattributes .github .gitignore README.md composer.json composer.lock node_modules vendor package-lock.json package.json .travis.yml phpcs.xml.dist sass style.css.map yarn.lock"
  }
}
